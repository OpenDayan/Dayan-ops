{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "kernel-qemu-debug",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/bin/kernels_pack.elf",
      "cwd": "${workspaceFolder}",
      "remote": true,
      "stopAtConnect": true,
      "target": "127.0.0.1:1234",
      "gdbpath": "gdb-multiarch",
      "preLaunchTask": "PreRun",
      "postDebugTask": "Terminate PreRun Task"
    }
  ]
}